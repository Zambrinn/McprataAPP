terraform {
  required_version = ">= 1.5.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }

  backend "s3" {
    bucket = "mcprata-tfstate-757859395071"
    key    = "messaging/terraform.tfstate"
    region = "us-east-1"
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = "MCPRATA ERP"
      Environment = "Production"
      ManagedBy   = "Terraform"
    }
  }
}
